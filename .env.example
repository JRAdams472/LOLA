# LOLA dev environment — copy to .env (never commit .env).
# Dev-only defaults below are safe for local; real deployments source all
# secrets from the environment / OpenBao, never from files in the repo.

OPENBAO_ADDR=http://localhost:8300
# Api token is minted by openbao-init into ./data/openbao/api-token
# (gitignored). For `dotnet run`, point the file-based loader at it:
OPENBAO_TOKEN_FILE=data/openbao/api-token
# OPENBAO_TOKEN is honored too, but prefer the file — secrets stay out of
# shell history/env dumps.
# Lola.Infrastructure.Tests needs a ROOT-capable token (mount + key
# admin): OPENBAO_TOKEN=$(cat data/openbao/root-token) for local runs.
S3_ENDPOINT=http://localhost:9200
S3_PUBLIC_ENDPOINT=http://localhost:9200
CLAMAV_ADDR=localhost:3310
CONTROL_DB_PATH=data/control.db   # control-plane SQLite — host path for `dotnet run`
TENANT_DATA_DIR=data/tenants      # per-tenant SQLCipher files — host path for `dotnet run`
# OIDC (OpenIddict): dev signing/encryption keys are generated once and
# persisted under gitignored data/oidc/. Real deployments source them
# from a managed key store — see docs/identity-runbook.md (M3 Phase 4).
OIDC_SIGNING_KEY_PATH=data/oidc/signing.json
OIDC_ENCRYPTION_KEY_PATH=data/oidc/encryption.json
# Seeds the lola-svc service client at boot when unset clients are missing.
# Dev-only convenience — real svc secrets are provisioned per-tenant.
OIDC_SEED_SVC_SECRET=change-me
# Borrower-portal base URL for invite links (dev delivery returns the
# link in the API response; a real impl swaps IInviteDelivery to email).
PORTAL_BASE_URL=http://localhost:3300
SEQ_URL=http://localhost:5441     # host :5441 — sibling Seq owns :5341
OTEL_SERVICE_NAME=lola
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317 # host :14317 → jaeger 4317
