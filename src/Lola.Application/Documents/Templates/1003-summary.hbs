<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>1003 Summary</title>
<style>
  body { font-family: sans-serif; font-size: 11px; margin: 24px; }
  h1 { font-size: 16px; } h2 { font-size: 13px; border-bottom: 1px solid #999; }
  table { border-collapse: collapse; width: 100%; }
  td, th { border: 1px solid #ccc; padding: 4px 6px; text-align: left; }
  .num { text-align: right; }
</style></head>
<body>
<h1>Uniform Residential Loan Application — Summary</h1>
<h2>Applicant</h2>
<table>
<tr><th>Name</th><td>{{applicant.name}}</td></tr>
<tr><th>Email</th><td>{{applicant.email}}</td></tr>
<tr><th>Phone</th><td>{{applicant.phone}}</td></tr>
<tr><th>Current Address</th><td>{{applicant.currentAddress}}</td></tr>
</table>
<h2>Employment</h2>
<table>
{{#each employment}}<tr><td>{{employer}}</td><td>{{selfEmployed}}</td></tr>{{/each}}
</table>
<h2>Loan &amp; Property</h2>
<table>
<tr><th>Loan Amount</th><td class="num">{{loanAmount}}</td></tr>
<tr><th>Loan Type / Purpose</th><td>{{loanType}} / {{loanPurpose}}</td></tr>
<tr><th>Term</th><td class="num">{{termMonths}} months</td></tr>
<tr><th>Property</th><td>{{propertyAddress}}</td></tr>
<tr><th>Sales Price</th><td class="num">{{salesPrice}}</td></tr>
<tr><th>Est. Value</th><td class="num">{{estimatedValue}}</td></tr>
</table>
</body></html>
