<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Loan Estimate</title>
<style>
  body { font-family: sans-serif; font-size: 11px; margin: 24px; }
  h1 { font-size: 16px; } h2 { font-size: 13px; border-bottom: 1px solid #999; }
  table { border-collapse: collapse; width: 100%; }
  td, th { border: 1px solid #ccc; padding: 4px 6px; text-align: left; }
  .num { text-align: right; }
</style></head>
<body>
<h1>Loan Estimate</h1>
<h2>Applicants</h2>
<table><tr><th>Borrower(s)</th><td>{{#each borrowerNames}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</td></tr>
<tr><th>Property</th><td>{{propertyAddress}}</td></tr>
<tr><th>Sales Price</th><td class="num">{{salesPrice}}</td></tr>
<tr><th>Est. Property Value</th><td class="num">{{estimatedValue}}</td></tr></table>

<h2>Loan Terms</h2>
<table>
<tr><th>Loan Amount</th><td class="num">{{loanAmount}}</td></tr>
<tr><th>Loan Type / Purpose</th><td>{{loanType}} / {{loanPurpose}}</td></tr>
<tr><th>Product</th><td>{{productCode}}</td></tr>
<tr><th>Term</th><td class="num">{{termMonths}} months</td></tr>
<tr><th>Interest Rate</th><td class="num">{{interestRate}}%</td></tr>
<tr><th>Monthly Principal &amp; Interest</th><td class="num">{{monthlyPrincipalInterest}}</td></tr>
<tr><th>Rate Lock Expires</th><td>{{rateLockExpiresUtc}}</td></tr>
</table>

<h2>Projected Closing Costs (Loan Estimate sections)</h2>
<table>
<tr><th>Section</th><th class="num">Amount</th></tr>
{{#each closingCosts}}<tr><td>{{section}}</td><td class="num">{{amount}}</td></tr>{{/each}}
</table>

<h2>Cash to Close</h2>
<table><tr><th>Estimated Cash to Close</th><td class="num">{{estimatedCashToClose}}</td></tr></table>
</body></html>
