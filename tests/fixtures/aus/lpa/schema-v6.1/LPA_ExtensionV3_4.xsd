    <xsd:complexType name="LOAN_LEVEL_CREDIT_DETAIL_EXTENSION">
        <xsd:sequence>
            <xsd:element name="BorrowerCreditScoresFirstExpirationDate" type="mismo:MISMODate" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The date of the first occurring credit report expiration date across all
                        borrowers.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="CreditRepositorySourceType" type="mismo:CreditRepositorySourceEnum" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>This element describes the source of the credit file, Equifax, Experian, Trans
                        Union or Unspecified if the specific sources are not specified.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="DecisionBorrowerName" type="mismo:MISMOString" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>An unstructured name that identifies the borrower on whose credit history the
                        automated underwriting evaluation was based.
                    </xsd:documentation>
