    <xsd:complexType name="QUALIFICATION_EXTENSION">
        <xsd:sequence>
            <xsd:element name="CalculatedQualifyingInterestRatePercent" type="mismo:MISMOPercent" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The rate used to calculate the borrowers payment (PITI)
                        to qualify the borrower for the subject mortgage.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="OccupantBorrowersHousingExpenseRatioPercent" type="mismo:MISMOPercent" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>A portion of 100 that represents the ratio of the proposed monthly housing
                        expenses to the qualifying income of the occupant borrowers as per lender or investor
                        guidelines.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="OccupantBorrowersTotalDebtExpenseRatioPercent" type="mismo:MISMOPercent" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>A portion of 100 that represents the ratio of all monthly debt payments,
                        including proposed housing expenses, to the income of the occupant borrowers as per lender or
                        investor guidelines.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="NonOccupantBorrowersTotalNonHousingLiablitiesMonthlyPaymentAmount"
                         type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total non-housing monthly liabilities for all non-occupant borrowers on the
                        loan.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalAssessedMonthlyIncomeAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total assessed monthly qualifying income for all borrowers on the loan.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalRequiredFundsAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total amount of borrower funds to be used to purchase or finance the
                        property, per investor guidelines.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalRequiredReservesAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total amount of borrower reserves required by investor guidelines.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalMonthlyResidualIncomeAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total amount of remaining monthly income for all  Borrowers, as determined
                        by subtracting the Borrowers' monthly housing and non-housing expenses from their net
                        (take home) monthly incomes.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
        <xsd:attributeGroup ref="xlink:MISMOresourceLink">
