    <xsd:complexType name="ASSET_SUMMARY_EXTENSION">
        <xsd:sequence>
            <xsd:element name="TotalAssetDeficitAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total dollar amount insufficient to meet total funds to be verified based on
                        the third party asset validation.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalEligibleAssetsAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total of all assets for all borrowers reported on an the URLA.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalFundsToBeVerifiedAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total funds from the borrower’s total eligible assets that need to be
                        verified by the Seller.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalThirdPartyAssetValidationAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total dollar amount of verified assets as determined by a third party
                        vailidation.
