                <xsd:annotation>
                    <xsd:documentation>METADATA_DETAIL holds detailed information about the action required by the feedback message, an associated Seller-Servicer Guide reference, and whether the message indicates any representation and warranty.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="DOCUMENTATION_GROUPS" type="lpa:MetadataDocumentationGroups" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Information about one or more DOCUMENTATION_GROUP container. Holds all occurrences of DOCUMENTATION_GROUP.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="MetadataDetail">
        <xsd:sequence>
            <xsd:element name="GuideReferenceIdentifier" type="mismo:MISMOString" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>A unique alphanumeric string identifying the Seller-Servicer Guide reference supporting the feedback message, as defined by Freddie Mac.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="RepresentationAndWarrantIndicator" type="mismo:MISMOIndicator_Base" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>When true, indicates that the feedback message sets forth representation and warranty eligibility.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="MetadataDocumentationGroups">
        <xsd:sequence>
	        <xsd:element name="DOCUMENTATION_GROUP" type="lpa:DocumentationGroup" minOccurs="0" maxOccurs="5">
	        	<xsd:annotation>
	        		<xsd:documentation>Each DOCUMENTATION_GROUP container identifies one set of loan documents referenced in the feedback message.</xsd:documentation>
	        	</xsd:annotation>
	        </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="DocumentationGroup">
        <xsd:sequence>
            <xsd:element name="SequenceNumber" type="mismo:MISMOSequenceNumber_Base">
                <xsd:annotation>
                    <xsd:documentation>An integer value used to provide an order to multi-instance sibling elements. The value must be unique for each sibling element.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="DOCUMENTATIONS" type="lpa:Documentations" minOccurs="0" maxOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Information about one or more DOCUMENTATION containers. Holds all occurrences of DOCUMENTATION.</xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
