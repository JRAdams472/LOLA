            <xsd:element name="AffordableLoanTotalSubordinateFinancingAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>
                        The total amount of subordinate financing associated with an affordable loan program.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="EnergyImprovementAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>
                        The dollar amount of a repair or improvement which will increase the energy efficiency of the building.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
            <xsd:element name="TotalSubordinateFinancingProceedsAppliedAmount" type="mismo:MISMOAmount" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>The total of the subordinate loan proceeds used for the mortgage transaction.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
