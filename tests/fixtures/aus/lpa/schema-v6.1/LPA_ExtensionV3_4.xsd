        <xsd:sequence>
            <xsd:element name="AMinusCautionFeeLevelDescription" type="mismo:MISMOString" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>A description of A-Minus/Caution fees that will be incurred by the seller at
                        delivery.
                    </xsd:documentation>
                </xsd:annotation>
