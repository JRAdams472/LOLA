    <xsd:complexType name="PAYMENT_RULE_EXTENSION">
        <xsd:sequence>
            <xsd:element name="PaymentDeferredFirstFiveYearsIndicator" type="mismo:MISMOIndicator" minOccurs="0">
                <xsd:annotation>
                    <xsd:documentation>When true, indicates that the principal and interest payment on the loan is not
                        due for the first five or more years following the note date.
                    </xsd:documentation>
                </xsd:annotation>
            </xsd:element>
        </xsd:sequence>
