# Borrower portal dev env — copy to clients/portal/.env.local for host
# dev (compose/web-borrower injects its own set).
SESSION_SECRET=dev-portal-session-secret-not-for-prod
API_URL=http://localhost:8200
OIDC_ISSUER=http://localhost:8200
OIDC_AUTHORIZE_URL=http://localhost:8200/connect/authorize
OIDC_TOKEN_URL=http://localhost:8200/connect/token
OIDC_CLIENT_ID=lola-borrower-portal
OIDC_REDIRECT_URI=http://localhost:3300/callback
PORTAL_SESSION_IDLE_MIN=30
PORTAL_SESSION_MAX_H=4
# SESSION_SECURE=1 marks the sealed session cookie Secure — required
# behind a real TLS terminator; must stay unset on http dev or the
# browser refuses the cookie entirely.
